<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Moku" parent="android:Theme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="singleMovieCoverTextDetail">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="HorizontalTextView">
        <item name="android:textAlignment">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@color/deeper_blue</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="customRatingBar" parent="android:style/Widget.Material.RatingBar.Small">
        <item name="android:scaleX">.92</item>
        <item name="android:scaleY">.92</item>
        <item name="android:transformPivotX">0dp</item>
        <item name="android:transformPivotY">0dp</item>
        <item name="android:backgroundTint">@color/deeper_blue</item>
        <item name="android:progressTint">@color/yellow_orange</item>
    </style>
    <style name="customProgressBar" parent="android:style/Widget.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/custom_progress_bar</item>
    </style>
</resources>